{
  "name": "shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:app": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "icons:android": "npx capacitor-assets generate --android --assetPath assets --iconBackgroundColor \"#4a1515\" --iconBackgroundColorDark \"#4a1515\"",
    "build:apk": "npm run build:app && bash scripts/build-android-release.sh",
    "init:android-keystore": "bash scripts/init-android-keystore.sh"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@iconify-json/tabler": "^1.2.34",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "element-china-area-data": "^6.1.0",
    "element-plus": "^2.13.7",
    "js-cookie": "^3.0.5",
    "ofetch": "^1.5.1",
    "qrcode": "^1.5.4",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.4",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "imagemin": "^9.0.1",
    "imagemin-pngquant": "^10.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.7"
  }
}
