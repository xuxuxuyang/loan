# =============================================================================
# admin 环境变量清单（示例文件，不参与运行）
#
# Vite 实际加载顺序（后加载覆盖先加载）：
#   .env
#   .env.local                    # 本机私有，不提交
#   .env.[mode]                   # 例如 .env.development / .env.production / .env.subsystem
#   .env.[mode].local             # 本机私有，不提交
#
# 约定：
# - 生产默认值写在 .env.production。
# - 开发默认值写在 .env.development。
# - 子系统构建默认值写在 .env.subsystem。
# - 本机或临时发布覆盖写在 .env.*.local。
# - 只有 VITE_ 开头的变量会进入前端包；密钥、私钥、token 必须放后端环境。
# =============================================================================

# --- 商城 API 根路径 ---
# 必须带 /api 前缀，不要以 / 结尾。
# 本地示例：http://127.0.0.1:3110/api
# 生产示例：https://wenshuosc.com/api
VITE_MALL_API_BASE=

# --- 商城 H5 根地址 ---
# 用于“流量管理”的推广链接生成，不要以 / 结尾。
# 本地示例：http://localhost:5173
# 生产示例：https://wenshuosc.com
VITE_MALL_H5_ORIGIN=

# --- 租户标识 ---
# 留空时前端会尝试从子域名首段解析；本地/IP 默认回退 default。
# 需要固定某租户时显式填写。
# VITE_TENANT_ID=default

# --- 平台账号用户名白名单 ---
# 逗号分隔。仅用于兼容后端旧版本未返回 scopeType 的会话。
# 命中白名单且角色为 super_admin 时，前端兜底识别为平台账号。
# VITE_PLATFORM_USERNAMES=xuyang

# --- 默认授信额度 ---
# 默认授信额度由 vite.config.ts 从 api/.env.[mode] 注入。
# 不建议在 admin 重复配置，除非明确需要构建时覆盖。
# VITE_MALL_DEFAULT_CREDIT_QUOTA=
