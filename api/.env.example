# 华东云开放接口（真实环境）。复制为 .env 后填写，勿提交 .env。
HD_CLOUD_BASE_URL=https://hd-cloud.nbhdian.com
HD_CLOUD_APP_ID=
HD_CLOUD_APP_KEY=

# 风控开放接口（独立前缀 /risk-api，与 /api 分离）
# RISK_CONTROL_APP_ID=
# RISK_CONTROL_APP_KEY=
# 多应用可选：JSON 数组，每项含 appid、appkey
# RISK_CONTROL_CREDENTIALS_JSON=[{"appid":"demo","appkey":"secret"}]
# 请求时间与服务器偏差上限（秒），默认 300
# RISK_CONTROL_TIMESTAMP_SKEW_SECONDS=300
# 未配置凭证时是否拒绝所有需验签路由（默认 true）；false 时仅便于本地调试
# RISK_CONTROL_REQUIRE_CREDENTIALS=true

# 风控上游：转发华东云等开放平台（信誉初审、管理端单项查询共用）。
# 若未设置下列三项，将回退读取上方的 HD_CLOUD_*（只需配一套即可）。
# RISK_UPSTREAM_BASE_URL=https://example.com
# RISK_UPSTREAM_APP_ID=
# RISK_UPSTREAM_APP_KEY=
# RISK_UPSTREAM_COURT_DETAIL_PATH=/api/risk.v4/courtDetailPro
# RISK_UPSTREAM_EXECUTION_PRO_PATH=/api/risk.v4/executionPro
# RISK_UPSTREAM_PROBE_C_ENC_PATH=/api/risk.V5/probeCEnc
# RISK_UPSTREAM_RADAR_V4_ENC_PATH=/api/risk.V5/radarV4Enc
# RISK_UPSTREAM_OCR_IDENTIFY_PATH=/api/sign/ocrIdentify
# RISK_UPSTREAM_PERSONAL3_PATH=/api/datapay/personal3
# RISK_UPSTREAM_DS_PHONE_TIME_PATH=/api/risk/dsPhoneTime
# RISK_UPSTREAM_DS_PHONE_STATE_PATH=/api/risk/dsPhoneState
# RISK_UPSTREAM_MOBILE2_PATH=/api/datapay/mobile2
# RISK_UPSTREAM_AUTH_PERSON_MOBILE3_PATH=/api/sign/authPersonMobile3
# RISK_UPSTREAM_AUTH_COMPANY_MOBILE3_PATH=/api/sign/authCompanyMobile3
# RISK_UPSTREAM_CAPTCHA_VERIFY_PATH=/api/sign/captchaVerify
# RISK_UPSTREAM_CAPTCHA_RESEND_PATH=/api/sign/captchaResend
# RISK_UPSTREAM_GET_AUTH_RECORD_INFO_PATH=/api/sign/getAuthRecordInfo
# RISK_UPSTREAM_AUTH_PERSON_FACE_PATH=/api/sign/authPersonFace
# RISK_UPSTREAM_USER_FACE_RESULT_PATH=/api/sign/userFaceResult
# RISK_UPSTREAM_ADD_PERSONAL_USER_PATH=/api/sign/addPersonalUser
# RISK_UPSTREAM_ADD_ENTERPRISE_USER_PATH=/api/sign/addEnterpriseUser
# RISK_UPSTREAM_CREATE_CONTRACT_PATH=/api/sign/createContract
# RISK_UPSTREAM_ADD_SIGNER_PATH=/api/sign/addSigner
# RISK_UPSTREAM_GET_CONTRACT_PATH=/api/sign/getContract
# RISK_UPSTREAM_DOWNLOAD_CONTRACT_PATH=/api/sign/downloadContract
# RISK_UPSTREAM_CL_SMS_SEND_PATH=/api/clSms/send
# RISK_UPSTREAM_CL_SMS_NOTIFY_PATH=/api/clSms/notify
# RISK_UPSTREAM_TIMEOUT_MS=60000
#
# 下单仅跑 7 项上游风控（见 upstreamClient.runOrderSubmitUpstreamRiskPack）；未配置上游时默认拒绝。
# 本地联调可设 1 跳过七项真实调用（勿用于生产）
# RISK_ORDER_SUBMIT_SKIP_UPSTREAM=0
#
# 下单「信誉初审」编排（api/src/riskControl/preliminaryReview.js）
# RISK_PRELIMINARY_PLACEHOLDER_ID=
# RISK_PRELIMINARY_ENABLE_SMS=0
# RISK_PRELIMINARY_CONTRACT_TRY=0
# 未连通 Mongo、且 ALLOW_JSON_FALLBACK≠true → 进程直接退出。
# URI 写在 api/.env 或项目根 .env。
# MONGODB_URI=mongodb://root:PASSWORD@dds-bp1bf113d9e8cb84-pub.mongodb.rds.aliyuncs.com:3717/mall?authSource=admin&replicaSet=mgset-100272228
# MONGODB_DB_NAME=mall
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_REQUIRED=true
# 仅无 Mongo 的本地调试：ALLOW_JSON_FALLBACK=true（会读/写 api/data/db.json，勿用于生产）
# ALLOW_JSON_FALLBACK=false
# 密码含特殊字符需 URL 编码。云上空库时自动写入「空业务 + defaultBootstrap 默认账号」。
# 若存在临时 db.json 可覆盖云库：npm run import:mongo-local
# 忽略本地文件、仅用代码内置空库+超管覆盖云库：npm run mongo:fresh（API 在跑时请重启）
