# =============================================================================
# 多环境配置（推荐）
# -----------------------------------------------------------------------------
# 进程基础：
# PORT=3110
# NODE_ENV=development
#
# 变量请写在「这两个文件」里（与 NODE_ENV 对应，勿提交到 Git）：
#   • api/.env.development  — 本地 / 联调（npm run dev 已带 NODE_ENV=development）
#   • api/.env.production   — 生产（npm start 已带 NODE_ENV=production）
# 全量变量名与说明见本文件下文；勿提交含密钥的 .env.development / .env.production。
# 可选：api/.env 仅补充上述文件里没写的键；api/.env.local 本机覆盖；仓库根 .env 再补缺。
# 加载逻辑：api/src/loadEnv.js
# =============================================================================

# BOOTSTRAP_SUPER_ADMIN_USERNAME=
# BOOTSTRAP_SUPER_ADMIN_PHONE=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# 是否在「商城注册用户 users」里注入与超管同手机号的影子用户（默认不注入，全量测试注册用户列表应为空）。
# 若需旧行为（H5 用超管手机号直接当商城用户测登录），设为 true：
# BOOTSTRAP_INJECT_DEFAULT_MALL_USER=true

# 商城新用户默认授信额度（元）→ 分别在 api/.env.development 与 api/.env.production 配置
# MALL_DEFAULT_CREDIT_QUOTA=2750

# 华东云开放接口（真实环境）。亦可只维护 .env.development / .env.production，本文件作全量字典参考。
# HD_CLOUD_BASE_URL=https://hd-cloud.nbhdian.com
# HD_CLOUD_APP_ID=
# HD_CLOUD_APP_KEY=
# 兼容别名（与上方等价，二选一套即可）：
# CLOUD_API_BASE_URL=
# HD_CLOUD_HOST=
# CLOUD_APP_ID=
# CLOUD_APP_KEY=

# 风控开放接口（独立前缀 /risk-api，与 /api 分离）
# RISK_CONTROL_APP_ID=
# RISK_CONTROL_APP_KEY=
# 多应用可选：JSON 数组，每项含 appid、appkey
# RISK_CONTROL_CREDENTIALS_JSON=[{"appid":"demo","appkey":"secret"}]
# 请求时间与服务器偏差上限（秒），默认 300
# RISK_CONTROL_TIMESTAMP_SKEW_SECONDS=300
# 未配置凭证时是否拒绝所有需验签路由（默认 true）；false 时仅便于本地调试
# RISK_CONTROL_REQUIRE_CREDENTIALS=true


# 风控上游：转发华东云等开放平台（信誉初审、管理端单项查询共用）。
# 若未设置下列三项，将回退读取上方的 HD_CLOUD_*（只需配一套即可）。
# RISK_UPSTREAM_BASE_URL=https://example.com
# RISK_UPSTREAM_APP_ID=
# RISK_UPSTREAM_APP_KEY=
# RISK_UPSTREAM_COURT_DETAIL_PATH=/api/risk.v4/courtDetailPro
# RISK_UPSTREAM_EXECUTION_PRO_PATH=/api/risk.v4/executionPro
# RISK_UPSTREAM_PROBE_C_ENC_PATH=/api/risk.V5/probeCEnc
# RISK_UPSTREAM_RADAR_V4_ENC_PATH=/api/risk.V5/radarV4Enc
# RISK_UPSTREAM_OCR_IDENTIFY_PATH=/api/sign/ocrIdentify
# RISK_UPSTREAM_PERSONAL3_PATH=/api/datapay/personal3
# RISK_UPSTREAM_DS_PHONE_TIME_PATH=/api/risk/dsPhoneTime
# RISK_UPSTREAM_DS_PHONE_STATE_PATH=/api/risk/dsPhoneState
# RISK_UPSTREAM_MOBILE2_PATH=/api/datapay/mobile2
# RISK_UPSTREAM_AUTH_PERSON_MOBILE3_PATH=/api/sign/authPersonMobile3
# RISK_UPSTREAM_AUTH_COMPANY_MOBILE3_PATH=/api/sign/authCompanyMobile3
# RISK_UPSTREAM_CAPTCHA_VERIFY_PATH=/api/sign/captchaVerify
# RISK_UPSTREAM_CAPTCHA_RESEND_PATH=/api/sign/captchaResend
# RISK_UPSTREAM_GET_AUTH_RECORD_INFO_PATH=/api/sign/getAuthRecordInfo
# RISK_UPSTREAM_AUTH_PERSON_FACE_PATH=/api/sign/authPersonFace
# RISK_UPSTREAM_USER_FACE_RESULT_PATH=/api/sign/userFaceResult
# RISK_UPSTREAM_ADD_PERSONAL_USER_PATH=/api/sign/addPersonalUser
# RISK_UPSTREAM_ADD_ENTERPRISE_USER_PATH=/api/sign/addEnterpriseUser
# RISK_UPSTREAM_CREATE_CONTRACT_PATH=/api/sign/createContract
# RISK_UPSTREAM_ADD_SIGNER_PATH=/api/sign/addSigner
# RISK_UPSTREAM_GET_CONTRACT_PATH=/api/sign/getContract
# 卡包 mock 签署 iframe 与合同页内 ACK 请求的「浏览器可见」API 根；商城与 Node 分拆部署且 Nginx X-Forwarded-Host 为前端域名时强烈建议设为真实 API 入口（无路径尾斜杠），否则会拼错到静态站域名。
# MALL_PUBLIC_API_ORIGIN=https://your-api-domain.example.com
# 商城「卡包领取」创建电子合同时，上游要求 contractFiles（待签 PDF 的 HTTPS 直链，平台会拉取）。
# 填一个即可；多个用英文逗号分隔，或 JSON 数组，例如 ["https://cdn.example.com/a.pdf"]
# MALL_CARD_PACKAGE_CONTRACT_FILE_URL=
# MALL_CARD_PACKAGE_CONTRACT_FILE_URLS=
# 自建静态：API 进程挂载 GET /static/* → api/public/*。示例（本地）：http://localhost:3110/static/contracts/%E5%8D%A1%E5%8C%85%E9%A2%86%E5%8F%96%E5%90%88%E5%90%8C%E6%A8%A1%E6%9D%BF.pdf
# 生产填公网 HTTPS 根域名（与部署一致）。模板文件亦在 shop/public/contracts，可与 api/public/contracts 同步。
# 卡包合同：设为 1 时走本地模拟签署（不调开放平台电子签）。下载 PDF 由服务端用 puppeteer 按「合同预览页」同数据渲染生成（与静态 api/public/contracts 模板稿无关）。
# MALL_CARD_PACKAGE_CONTRACT_MOCK=1
# （可选）使用本机 Chrome/Edge 生成 PDF：未设置时使用 puppeteer 自带的 Chromium
# PUPPETEER_EXECUTABLE_PATH=
# 卡包模拟合同 PDF：Chromium --print-to-pdf 超时（毫秒），默认 120000。首次无缓存下载可能接近该耗时；
# 生产须在 Nginx 反代上把 proxy_read_timeout / proxy_send_timeout 调到明显大于此值（建议 300s），否则会出现 502/504 与 nginx 50x 页。
# CARD_PACKAGE_PDF_CLI_TIMEOUT_MS=120000
# Linux 下是否禁用 Sparticuz Chromium（1=禁用，默认 0）
# CARD_PACKAGE_PDF_NO_SPARTICUZ=0
# 是否优先使用 Chromium CLI 生成 PDF（1=优先，默认 0）
# CARD_PACKAGE_PDF_PREFER_CLI=0
# Linux 下在未显式启用 preferCli 时，是否默认先走 CLI（默认 1）
# CARD_PACKAGE_PDF_LINUX_CLI_FIRST=1
# —— 本地模拟《商品购销及服务协议》：甲方（用户）+ 乙方（商户），无二方以外「丙方」；行文中的渠道称谓见 MALL_CONTRACT_SITE_LABEL。
# MALL_CONTRACT_DOC_TITLE=商品购销及服务协议（分期商城）
# 协议正文里「通过○○购买」的渠道名，不配则用「本商城」
# MALL_CONTRACT_SITE_LABEL=本商城
# 安卓 App 通讯录分批上传单批最大条数；默认 200。不要为通讯录提高全局 bodyParser 体积限制。
# MALL_CONTACTS_UPLOAD_BATCH_SIZE=200
# MALL_CONTRACT_MERCHANT_NAME=乙方（入驻商家）企业名称
# MALL_CONTRACT_MERCHANT_USCC=乙方统一社会信用代码
# MALL_CONTRACT_MERCHANT_ADDRESS=乙方住所
# MALL_CONTRACT_MERCHANT_PHONE=乙方联系电话
# MALL_CONTRACT_MERCHANT_LEGAL=乙方法定代表人
# MALL_CONTRACT_SERVICE_HOTLINE=400-xxxxxxxx（显示在「特别提醒」）
# MALL_CONTRACT_DISPUTE_TEXT=（可选；完全自定义争议条款；不配则默认为「乙方住所地」管辖表述）
# MALL_CONTRACT_CREDIT_HOTLINE_NOTE=（可选，征信/授权段落的补充说明）
# 卡包「添加签署方」前需在签约平台登记个人用户：人脸/实名返回的 serialNo，写入用户 signAuthSerialNo（仅管理端），或临时联调用：
# MALL_CARD_PACKAGE_SIGN_AUTH_SERIAL=
# RISK_UPSTREAM_CL_SMS_SEND_PATH=/api/clSms/send
# RISK_UPSTREAM_CL_SMS_NOTIFY_PATH=/api/clSms/notify
# RISK_UPSTREAM_TIMEOUT_MS=60000
#
# 下单仅跑 7 项上游风控（见 upstreamClient.runOrderSubmitUpstreamRiskPack）；未配置上游时默认拒绝。
# 本地联调可设 1 跳过七项真实调用（勿用于生产）
# RISK_ORDER_SUBMIT_SKIP_UPSTREAM=0
#
# 下单「信誉初审」编排（api/src/riskControl/preliminaryReview.js）
# RISK_PRELIMINARY_PLACEHOLDER_ID=
# RISK_PRELIMINARY_ENABLE_SMS=0
# RISK_PRELIMINARY_CONTRACT_TRY=0
# 未连通 Mongo、且 ALLOW_JSON_FALLBACK≠true → 进程直接退出。
# URI 写在 api/.env.development 或 api/.env.production（推荐），或兼容 api/.env / 项目根 .env。
# MONGODB_URI=mongodb://root:PASSWORD@dds-bp1bf113d9e8cb84-pub.mongodb.rds.aliyuncs.com:3717/mall?authSource=admin&replicaSet=mgset-100272228
# MONGODB_DB_NAME=mall
# MONGODB_MAX_POOL_SIZE=10
# 兼容别名（与上方等价）：
# MONGO_URI=
# DATABASE_URL=
# MONGO_DB_NAME=
# MONGO_MAX_POOL_SIZE=
# 管理端只读优化总开关（二选一或都设 true）：
# - 订单/用户列表先分页再 enrich
# - 流量统计订单索引、流量页 overview 合并请求、Mongo 并发 refresh 合并
# - 产品/流量/侧栏角标/仪表盘 KPI 短缓存（配合 API_ADMIN_READ_CACHE_TTL_MS）
# - 账号列表 GET 仅增量刷新 adminAccounts；鉴权跨库查找短缓存（API_ADMIN_AUTH_CACHE_TTL_MS）
# API_LIST_PAGINATE_BEFORE_ENRICH=true
# API_ADMIN_READ_OPTIMIZE=true
# API_ADMIN_READ_CACHE_TTL_MS=45000
# API_ADMIN_AUTH_CACHE_TTL_MS=30000

# Mongo 快照 refresh（默认 version；紧急回滚 every_request）
# MONGO_REFRESH_MODE=every_request
# MONGO_REFRESH_MODE=single_instance
# MONGODB_REQUIRED=true
# 兼容旧开关：DISABLE_JSON_STORE=true 等价于 MONGODB_REQUIRED=true
# DISABLE_JSON_STORE=
# 仅开发/测试：每个 /api 请求返回前 await Mongo 持久化队列，便于 Compass/脚本立刻读到刚写入的数据（略增延迟，生产勿开）
# MONGO_AWAIT_PERSIST=true
# 兼容别名：
# STORE_AWAIT_MONGO_PERSIST=
# 密码含特殊字符需 URL 编码。云上空库时自动写入「空业务 + defaultBootstrap 默认账号」。
#
# —— 商城注册短信验证码 ——
# 走风控上游「验证码短信」接口：POST /api/clSms/send（与 api/src/riskControl/upstreamClient.js 的 postClSmsSend 一致），
# 需已配置 RISK_UPSTREAM_BASE_URL、RISK_UPSTREAM_APP_ID、RISK_UPSTREAM_APP_KEY（或与 HD_CLOUD_* 等价一套）。
# 上游通常要求正文含「【签名】」前缀（与短信平台备案签名一致），见 RISK_CONTROL_API.md § cl-sms-send。
# 未设置 MALL_REGISTER_SMS_MSG_TEMPLATE 时，默认：【文硕商城】您的注册验证码为{code}，5分钟内有效（见 mallRegisterSms.js）。
# 商城注册短信：须与备案签名一致（缺省模板见 mallRegisterSms.js，默认可为【文硕商城】）。
# 勿与「信誉初审」初审联调文案混用——那是 preliminaryReview 里另一条测试文案，用于订单初审通道联调。
# MALL_REGISTER_SMS_SIGN_BRACKET=文硕商城
# 自定义备案名示例：
# MALL_REGISTER_SMS_SIGN_BRACKET=某某科技
# 或整条自定义（须含 {code}，且建议含【备案签名】）：
# MALL_REGISTER_SMS_MSG_TEMPLATE=【某某科技】您的注册验证码为{code}，5分钟内有效。
# 若只写正文不配【】，可只设 MALL_REGISTER_SMS_SIGN_BRACKET，会自动加【】前缀。
# MALL_REGISTER_SMS_MSG_TEMPLATE=
# 验证码有效期、同一手机号再次发送间隔（毫秒），可选
# MALL_REGISTER_SMS_TTL_MS=300000
# MALL_REGISTER_SMS_RESEND_MS=60000
#
# —— 商城登录短信验证码 ——
# 与注册共用 MALL_REGISTER_SMS_SIGN_BRACKET：若 MALL_LOGIN_SMS_MSG_TEMPLATE 不含「【…】」，会自动加【签名】前缀。
# 正文必须包含占位符 {code}（6 位数字）；否则 API 会返回配置错误。
# MALL_LOGIN_SMS_MSG_TEMPLATE=【某某科技】您的登录验证码为{code}，5分钟内有效。
# 不配则使用代码内默认：【签名】您的登录验证码为{code}，5分钟内有效（签名取自 MALL_REGISTER_SMS_SIGN_BRACKET）。
#
# —— 商城推广渠道（注册归因）——
# H5 访问 ?channel=渠道标识 后完成注册；渠道在后台「流量管理」维护，数据存库 trafficChannels / users.registerChannelCode。
# 访问带 channel 的链接会 POST /api/traffic/channel-click 累计点击数（供 admin-liuliang 流量商后台展示）。
# 流量商门户账号存 trafficPartners，由超级管理员 POST /api/admin/traffic-partners 创建（绑定 channelCodes）。
# 无需单独环境变量。
#
# —— 后台权限开关（可选）——
# ENFORCE_ADMIN_RBAC=true
#
# —— 多子系统（最小实现）——
# 客户端可通过请求头 x-tenant-id 指定子系统（推荐由前端统一注入）。
# 不传时后端会尝试从 Host 子域名首段推断；仍无值则回退 default。
# 示例：m.demo.example.com -> tenant=demo

# —— 阿里云 OSS（身份证图片上传）——
# 注册页会先把身份证图片上传 OSS，再将 URL 写入 idCardFront / idCardBack / idCardHandheld。
# 必填：region、bucket、access key；OSS 公网域名可用 public base url 指定（推荐 https）。
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 可选：内网域名或自定义 endpoint（不填则按 region 推导）
# OSS_ENDPOINT=
# 可选：对象访问前缀，如 https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# OSS_PUBLIC_BASE_URL=
# 可选：上传目录前缀（会自动拼接环境标签），默认 mall/id-cards
# OSS_UPLOAD_PREFIX=mall/id-cards
# 可选：环境标签（用于 dev/prod 数据隔离），默认取 NODE_ENV
# OSS_ENV_TAG=development
# 可选：身份证图片最大像素（百万像素 MP），默认 20
# OSS_IDCARD_MAX_IMAGE_MEGAPIXELS=20
#
# —— 拉卡拉聚合收银台（商城真实支付）——
# 文档索引见仓库根「支付接入」；未配置密钥时开发环境默认 LAKALA_MOCK=1（可点「模拟支付成功」联调）。
# LAKALA_APP_ID=
# LAKALA_SERIAL_NO=
# LAKALA_MERCHANT_NO=
# LAKALA_TERM_NO=              # 文档测试终端号；仅当 LAKALA_COUNTER_SEND_TERM_NO=1 时会上送
# LAKALA_COUNTER_SEND_TERM_NO=0  # 1=下单带 term_no（支付宝易报门店编号无效，默认 0）
# LAKALA_COUNTER_PAY_MODE=ALL    # ALL=全部方式；WECHAT/ALIPAY=仅允许该方式（慎用）
# LAKALA_PAY_DEBUG=0             # 1=打印 special_create req_data
# LAKALA_ORDER_EFFICIENT_MINUTES=120
# LAKALA_VPOS_ID=                # 非合单一般勿配
# LAKALA_CHANNEL_ID=             # 渠道号（一般不用）
# LAKALA_PRIVATE_KEY=          # PEM 全文，或改用 LAKALA_PRIVATE_KEY_PATH 指向文件
# LAKALA_PLATFORM_PUBLIC_KEY=  # 验签拉卡拉响应/通知（可选但建议配置）
# LAKALA_NOTIFY_URL=https://你的API域名/api/payment/lakala/notify
# LAKALA_CALLBACK_URL=https://你的商城H5域名/my/orders   # 支付完成后浏览器回跳（可选）
# LAKALA_API_BASE=             # 留空：生产 https://s2.lakala.com，开发 https://test.wsmsd.cn/sit
# LAKALA_MOCK=1                # 强制模拟；生产务必 0 且配齐上方密钥

# ---- 哆点点专属渠道接口配置 ----
# 接口身份：给哆点点的商户号，回调/请求必须使用该值。
# DUODIANDIAN_PARTNER=duodiandian
# 数据隔离：系统内部合作商标识和推广渠道标识，所有记录都锁定在此渠道。
# DUODIANDIAN_PARTNER_CODE=duodiandian
# DUODIANDIAN_CHANNEL_CODE=duodiandian
# DUODIANDIAN_CHANNEL_NAME=哆点点
# DUODIANDIAN_CHANNEL_REMARK=哆点点专属隔离推广渠道
# 接口路由：完整接口前缀为 /api + 以下前缀，例如 /api/open/partners/duodiandian/getUrl。
# DUODIANDIAN_ROUTE_PREFIX=/open/partners/duodiandian
# 验签加密：signKey 用于 MD5 签名；encKey 用于 AES/ECB/PKCS5Padding，长度必须是 16/24/32 字节。
# DUODIANDIAN_SIGN_KEY=
# DUODIANDIAN_ENC_KEY=
# DUODIANDIAN_TIMESTAMP_SKEW_MS=600000
# DUODIANDIAN_AUTO_LOGIN_TICKET_TTL_MS=600000
# Outbound notify URL. Fill the partner-provided order status notify URL.
# DUODIANDIAN_STATUS_NOTIFY_URL=https://notify.partner.example/halfFlow/<partner>/open/order/status/notify
# Optional yearlyRate field for AUDIT_PASS notify.
# DUODIANDIAN_YEARLY_RATE=0%
# DUODIANDIAN_DEFAULT_USER_QUOTA=2750
# 推广落地页：getUrl/apply 返回的商城 H5 根地址。
# DUODIANDIAN_H5_ORIGIN=https://your-shop-h5.example.com
# 流量商数据后台：启动时自动创建/绑定一个只能查看哆点点渠道的数据账号。
# DUODIANDIAN_PORTAL_USERNAME=duodiandian
# DUODIANDIAN_PORTAL_PASSWORD=
# DUODIANDIAN_PORTAL_NAME=哆点点
# 协议接口：contractQuery 返回的普通商城协议名称和 H5 路径。
# DUODIANDIAN_USER_AGREEMENT_NAME=用户协议
# DUODIANDIAN_USER_AGREEMENT_PATH=/user-agreement
# DUODIANDIAN_PRIVACY_POLICY_NAME=隐私政策
# DUODIANDIAN_PRIVACY_POLICY_PATH=/privacy-policy

# ---- 新流量渠道独立接口配置（默认关闭）----
# 说明：该模块完全独立于点多多；不开启时不注册路由、不加载业务模块。
# 我们把测试 API 地址、channel 和五个接口 URL 提供给流量商；流量商只提供授信审批结果回调 URL。
# ZHEYIN_TRAFFIC_ENABLED=false
# 我们提供给流量商调用的接口前缀；完整地址为 /api + 该前缀 + 接口路径。
# ZHEYIN_TRAFFIC_ROUTE_PREFIX=/open/partners/zheyin
# 我们提供给流量商的渠道编码，测试和生产分别配置。
# ZHEYIN_TRAFFIC_CHANNEL=zheyin_test
# AES/CBC/PKCS5Padding + Base64；测试值按接口文档填写，生产值上线前替换。
# ZHEYIN_TRAFFIC_AES_KEY=
# ZHEYIN_TRAFFIC_AES_IV=
# 对方提供的授信审批结果回调完整 URL。
# ZHEYIN_TRAFFIC_CREDIT_NOTIFY_URL=https://partner.example.com/zheyin-jr-api/api/dlApp/recCredit
# 授信默认参数：额度、期数、年利率、额度类型、有效天数。
# ZHEYIN_TRAFFIC_DEFAULT_AMOUNT=50000
# ZHEYIN_TRAFFIC_PERIODS=3,6,9,12
# ZHEYIN_TRAFFIC_YEAR_RATE=12%
# ZHEYIN_TRAFFIC_CREDIT_TYPE=1
# ZHEYIN_TRAFFIC_CREDIT_EXPIRE_DAYS=365
# 下载链接模板，支持 {orderId}/{applyNo}/{redirectUrl}/{channel}。
# ZHEYIN_TRAFFIC_LOAN_URL_TEMPLATE=https://your-h5.example.com/traffic-entry?orderId={orderId}&redirect={redirectUrl}&channel={channel}
# 协议配置 JSON。可按 scene 配置；default 为兜底。
# ZHEYIN_TRAFFIC_CONTRACTS_BY_SCENE={"1":[{"contractName":"个人征信授权协议","contractUrl":"https://example.com/contract/credit.pdf"}],"default":[]}

# =============================================================================
# 新增可维护配置示例（中文备注，按需复制到对应环境）
# =============================================================================
# 商城用户密码哈希 pepper；上线后必须保持不变，否则历史用户密码校验会失败。
# MALL_PASSWORD_PEPPER=mall-local-pepper-v1

# 身份证图片上传大小上限，单位字节；默认 5242880（5MB）。
# MALL_ID_CARD_UPLOAD_MAX_BYTES=5242880

# 公共图片上传大小上限，单位字节；默认 8388608（8MB）。
# MALL_PUBLIC_IMAGE_UPLOAD_MAX_BYTES=8388608

# 逆地理编码服务地址；默认使用 OpenStreetMap Nominatim。
# REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

# 逆地理编码请求 User-Agent；第三方服务通常要求明确 UA。
# REVERSE_GEOCODE_USER_AGENT=tea-mall-registration/1.0 (dev)

# API 进程强制追加到 NO_PROXY 的地址，英文逗号分隔。
# API_REQUIRED_NO_PROXY=127.0.0.1,localhost,.aliyuncs.com

# Mongo 不可用时是否允许回退本地 JSON；生产必须 false 或不配置。
# ALLOW_JSON_FALLBACK=false

# 是否跳过写接口结束前等待 Mongo 落库；生产建议 false。
# MONGO_SKIP_MUTATION_FLUSH=false

# 拉卡拉 pending 支付单自动同步最大时间窗口，单位毫秒；默认 86400000（24 小时）。
# LAKALA_PENDING_SYNC_MAX_AGE_MS=86400000

# 单次最多同步的 pending 支付单数量；默认 5。
# LAKALA_PENDING_SYNC_LIMIT=5

# 拉卡拉收银台短链允许规范化解码的域名关键字，英文逗号分隔。
# LAKALA_COUNTER_URL_ALLOWED_HOSTS=pay.wsmsd.cn,pay.lakala.com,huijingcai

# 拉卡拉收银台默认选中的支付方式；可填 WECHAT / ALIPAY，留空按前端 payChannel。
# LAKALA_COUNTER_DEFAULT_PAY_MODE=

# 拉卡拉商户私钥文件路径；优先建议生产用文件路径，避免把 PEM 全文写入 env。
# LAKALA_PRIVATE_KEY_PATH=./secrets/your_private_key.pem

# 拉卡拉平台公钥/证书文件路径；用于验签拉卡拉响应和通知。
# LAKALA_PLATFORM_PUBLIC_KEY_PATH=./secrets/lakala-platform.cer

# ---- 后台管理端读取性能优化 / Mongo 运行参数 ----
# 说明：以下配置用于提升后台 admin 审核、订单列表、用户列表、侧栏角标的读取速度。
# 安全原则：只控制读取路径和连接参数，不迁移、不删除、不重写订单或用户业务数据。
# 紧急回滚：如果上线后后台列表或审核辅助展示异常，将 API_ADMIN_READ_OPTIMIZE 改为 false 后重启 API，即可回到旧的内存快照读取路径。

# 是否启用后台 admin 的 Mongo 直读优化。
# true：订单分页、用户分页、侧栏角标在安全场景下优先走 Mongo 分页/countDocuments；失败会自动回退旧逻辑。
# false：完全走原来的内存快照筛选/分页逻辑，适合紧急回滚。
API_ADMIN_READ_OPTIMIZE=true

# Mongo 快照刷新模式。
# version：推荐生产使用；仅当 app_meta.updatedAt 变化时刷新内存快照，减少每个请求都全量读 Mongo 导致的卡顿。
# every_request：每个 /api 请求都尝试刷新快照，读一致性最保守，但后台请求多时更容易慢；仅用于紧急回滚或排查。
# single_instance：仅单实例部署可考虑；多实例/PM2 cluster 不建议使用，避免跨进程读到旧快照。
MONGO_REFRESH_MODE=version

# MongoDB 连接池最大连接数。
# 20：适合当前后台审核、订单列表、用户列表和前台正常流量的保守值；如果数据库规格较小不要盲目调太高。
# 调大前请同时观察数据库 CPU、连接数、慢查询和 API pending 时间。
MONGODB_MAX_POOL_SIZE=20

# 审核接口慢日志阈值，单位毫秒。
# 500：审核通过/拒绝超过 500ms 时输出 [review-status-perf]，用于判断卡在读库、业务处理还是 flushMongoPersist 落库。
# 设为 0 或留空表示关闭审核慢日志。
API_REVIEW_SLOW_LOG_MS=500

# =============================================================================
# 流水风控接入配置（快速接入指南，单独维护）
# =============================================================================
# 上游 API 根地址；默认按文档使用 https://saas.flow.eeiai.cn/saas。
# BILL_RISK_API_BASE_URL=https://saas.flow.eeiai.cn/saas
# 获取 Token 接口路径；一般无需修改。
# BILL_RISK_TOKEN_PATH=/open/api/get/token
# 生成用户动态邮箱接口路径；签名 getUrl 使用同一个路径，不能带 /saas 前缀。
# BILL_RISK_MAIL_PATH=/open/api/user/many/mail
# 引导页地址；后端会拼接 flowId、backUrl、type 后返回给管理端展示。
# BILL_RISK_PROCESS_PAGE_URL=https://flow-process.699e.cn/billProcess
# H5 操作完成后的同步回跳地址；用于引导页操作完成后携带 isBack 返回，不是异步报告回调地址。
# BILL_RISK_BACK_URL=https://你的前端域名/risk-result?1=1
# 异步报告回调地址；需要提供给上游客服配置，API 已内置 POST /api/bill-risk/callback。
# BILL_RISK_CALLBACK_URL=https://你的API域名/api/bill-risk/callback
# 引导页类型，可选 h5、app、miniprogram；后台管理端默认使用 h5。
# BILL_RISK_PROCESS_TYPE=h5
# 上游分配的账号和密码；不要提交真实生产密钥到 Git。
# BILL_RISK_USERNAME=
# BILL_RISK_PASSWORD=
# 上游提供的 RSA 公钥；可写一行纯公钥，也可写 PEM 全文（换行用 \n）。
# BILL_RISK_PUBLIC_KEY=
# 可选：异步回调验签密钥；配置后按 MD5(mailId + 密钥) 校验 sign，不配置则只接收并入库。
# BILL_RISK_CALLBACK_SIGN_SECRET=
# 上游请求超时时间，单位毫秒；防止管理端等待过久导致卡顿。
# BILL_RISK_TIMEOUT_MS=15000
# 每个用户最多保留多少条流水报告回调历史；超过后只保留最新记录。
# BILL_RISK_REPORT_HISTORY_MAX=30
