# =============================================================================
# 本文件不参与运行：仅作「变量清单 + 说明」，给同事复制或对照用。
# Vite 实际加载的是（按模式合并，后加载覆盖先加载）：
#   .env
#   .env.local                    （建议 git 忽略，放本机密钥）
#   .env.[mode]                   例：.env.development、.env.production
#   .env.[mode].local
#
# 推荐做法：
#   - 开发默认值 → shop/.env.development
#   - 生产构建默认值 → shop/.env.production
#   - 本机覆盖（不提交）→ shop/.env.development.local / .env.production.local
#
# 注意：只有以 VITE_ 开头的变量会打进浏览器代码（import.meta.env）。
#       vite.config.ts 里用的 SHOP_API_PROXY_TARGET 来自 Node 侧 process.env，
#       写在 .env.development 即可，无需 VITE_ 前缀。
# =============================================================================

# --- 商城 API 基路径（前端 $fetch / useRuntimeConfig）---
# 留空：走同源 `/api`（开发时由 Vite 代理；线上由 Nginx 反代）
# 跨域：填完整 URL 前缀，不要末尾 /，例：https://api.example.com/api
VITE_MALL_API_BASE=
#
# 子系统标识（可选）：留空时前端自动从子域名首段提取（如 a.example.com → a），
# 本地/IP 默认回退为 default。需要固定某子系统时可显式填写。
# VITE_TENANT_ID=default

# 默认授信额度（元）→ 见 api/.env.development / api/.env.production，勿在 shop 重复配置

# --- 仅本地 npm run dev：Vite 把 /api 代理到该地址（见 vite.config.ts）---
SHOP_API_PROXY_TARGET=http://127.0.0.1:3110

# 商城支付依赖后端拉卡拉配置（见 api/.env.example）；本地未配密钥时 API 走模拟支付。

# --- 安卓 APK 直链（可选）：上传到 OSS 后填完整 HTTPS URL，用于「我的 → App下载」---
# 生产构建读 .env.production；本地 npm run dev 读 .env.development，两处可各配一份便于测试。
# 例：https://your-bucket.oss-cn-hangzhou.aliyuncs.com/app/wenshuo-mall-release.apk
# VITE_MALL_APP_APK_URL=

# --- 原生 App OTA（仅打进 APK 的 H5；发 OTA 见 npm run build:ota）---
# VITE_APP_OTA_MANIFEST_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/app-ota/latest.json
