# =============================================================================
# shop 环境变量清单（示例文件，不参与运行）
#
# Vite 实际加载顺序（后加载覆盖先加载）：
#   .env
#   .env.local                    # 本机私有，不提交
#   .env.[mode]                   # 例如 .env.development / .env.production
#   .env.[mode].local             # 本机私有，不提交
#
# 约定：
# - 生产默认值写在 .env.production。
# - 开发默认值写在 .env.development。
# - 本机或临时发布覆盖写在 .env.*.local。
# - 只有 VITE_ 开头的变量会进入前端包；密钥、私钥、token 必须放后端环境。
# =============================================================================

# --- 商城 API 基路径 ---
# 留空：走同源 /api（开发时由 Vite 代理；线上由 Nginx 反代）。
# 跨域：填完整 URL 前缀，不要末尾 /，例如 https://api.example.com/api。
VITE_MALL_API_BASE=

# --- 租户标识 ---
# 留空时前端自动从子域名首段提取（如 a.example.com -> a）。
# 本地/IP 默认回退 default；需要固定某租户时显式填写。
# VITE_TENANT_ID=default

# --- 商城站点与备案 ---
# VITE_MALL_SITE_URL：生产站点地址，用于 iOS 添加主屏幕引导等文案。
# VITE_MALL_ICP_TEXT：备案展示文本；为空则隐藏备案 footer。
# VITE_MALL_ICP_LINK：备案跳转地址，通常保持工信部备案查询站点。
# VITE_MALL_SITE_URL=https://your-shop.example.com
# VITE_MALL_ICP_TEXT=示例ICP备案号
# VITE_MALL_ICP_LINK=https://beian.miit.gov.cn/

# --- 第三方外链 ---
# 用户从订单页点击“查询物流”后打开该地址，并自行粘贴运单号查询。
# 项目未对接快递 API 前，不要把该 URL 写入组件或 composable。
# VITE_MALL_TRACKING_LOOKUP_URL=https://www.kuaidi100.com/

# --- 商城下单预风控规则 ---
# 年龄按身份证出生日期计算；边界值包含在内，例如 22/49 均允许。
# 地区名称用于匹配收货地址和手机号归属地文本；身份证前缀用于匹配身份证号码开头。
# 多个值用英文逗号分隔，不要加空格。修改后必须重新构建前端/APK。
# VITE_MALL_ORDER_MIN_AGE=22
# VITE_MALL_ORDER_MAX_AGE=49
# VITE_MALL_ORDER_RESTRICTED_REGION_NAMES=新疆,西藏,内蒙古,青海,宁波
# VITE_MALL_ORDER_RESTRICTED_ID_PREFIXES=65,54,15,63,3302

# --- 客服配置 ---
# VITE_MALL_KEFU_QR_URL：企业微信客服二维码完整 HTTPS 图片地址；为空时使用随包资源 src/assets/kefu.png。
# VITE_MALL_KEFU_DISPLAY_NAME：二维码下方展示名称。
# VITE_MALL_KEFU_QR_URL=
# VITE_MALL_KEFU_DISPLAY_NAME=在线客服

# --- 仅本地 npm run dev：Vite 把 /api 与 /static 代理到该地址 ---
# 该变量由 vite.config.ts 通过 loadEnv 读取，不需要 VITE_ 前缀。
SHOP_API_PROXY_TARGET=http://127.0.0.1:3110

# 默认授信额度（元）见 api/.env.development / api/.env.production。
# shop 侧仅保留 VITE_MALL_DEFAULT_CREDIT_QUOTA 作为构建覆盖口，不建议重复配置。
# VITE_MALL_DEFAULT_CREDIT_QUOTA=

# 点多多半流程免登消费接口前缀；只放路径，不含 /api，不含 /login/consume。
# VITE_DUODIANDIAN_HALF_FLOW_PREFIX=/market/halfFlow/590011549263990784/open

# 商城支付依赖后端拉卡拉配置（见 api/.env.example）；本地未配密钥时 API 走模拟支付。

# --- 安卓 APK 直链 ---
# 上传到 OSS 后填完整 HTTPS URL，用于“我的 -> App 下载”。
# 生产构建写 .env.production；本地联调可写 .env.development。
# VITE_MALL_APP_APK_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/app/wenshuo-mall-release.apk

# --- 原生 App OTA ---
# VITE_APP_OTA_MANIFEST_URL：打进 APK 的 latest.json 地址，Capacitor 启动时读取。
# VITE_APP_OTA_BASE_URL：npm run build:ota 生成 latest.json 时拼接 zip URL 的上传目录。
# 两者应指向同一个目录；BASE_URL 不要以 / 结尾。
# VITE_APP_OTA_MANIFEST_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/app-ota/latest.json
# VITE_APP_OTA_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/app-ota
